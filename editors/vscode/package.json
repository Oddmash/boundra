{
  "name": "boundra-vscode",
  "displayName": "Boundra",
  "description": "Workspace boundary diagnostics from the Boundra CLI",
  "publisher": "oddmash",
  "version": "0.0.1",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [{ "command": "boundra.checkWorkspace", "title": "Boundra: Check Workspace" }]
  }
}
