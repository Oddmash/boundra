{
  "name": "boundra-vscode",
  "displayName": "Boundra",
  "description": "TypeScript domain and import boundary diagnostics from the Boundra CLI",
  "publisher": "oddmash",
  "version": "0.1.1",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Oddmash/boundra.git", "directory": "editors/vscode" },
  "homepage": "https://oddmash.github.io/boundra/docs/user-guide/",
  "bugs": { "url": "https://github.com/Oddmash/boundra/issues" },
  "categories": ["Linters"],
  "keywords": ["boundra", "typescript", "architecture", "boundaries", "domain boundaries", "import rules", "diagnostics"],
  "engines": { "vscode": "^1.95.0" },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [{ "command": "boundra.checkWorkspace", "title": "Boundra: Check Workspace" }]
  }
}
