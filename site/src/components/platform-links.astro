---
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { PlatformLink, PlatformLinks } from '@oddmash/ui/platform-link';

const githubLabel = 'Boundra · GitHub';
const npmLabel = 'Boundra · npm';
const markup = renderToStaticMarkup(createElement(PlatformLinks, { className: 'platform-links' },
  createElement(PlatformLink, { className: 'platform-link', platform: 'github', href: 'https://github.com/Oddmash/boundra', 'aria-label': githubLabel, title: githubLabel }),
  createElement(PlatformLink, { className: 'platform-link', platform: 'npm', href: 'https://www.npmjs.com/package/boundra', 'aria-label': npmLabel, title: npmLabel }),
));
---
<Fragment set:html={markup} />
