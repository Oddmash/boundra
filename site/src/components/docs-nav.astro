---
import { groups } from '../docs-nav';
const { slug = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/docs/';
---
<nav aria-label="Documentation"><a class="docs-home" href={base}>Documentation</a>{groups.map(group => <div class="nav-group"><h2>{group.label}</h2>{group.items.map(([path, label]) => <a href={`${base}${path}/`} aria-current={slug === path ? 'page' : undefined}>{label}</a>)}</div>)}</nav>
<div class="languages"><a href={`${base}user-guide/`} lang="en">EN</a><a href={`${base}user-guide.ko/`} lang="ko">한국어</a><a href={`${base}user-guide.ja/`} lang="ja">日本語</a><a href={`${base}user-guide.zh-cn/`} lang="zh-CN">简体中文</a></div>
