---
import { localGroups, docsHome } from '../docs-nav';
import { docCopy, localeFromLang } from '../doc-ui-copy';
const { slug = '', lang = 'en' } = Astro.props;
const locale = localeFromLang(lang);
const t = docCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const groups = localGroups(base,locale);
---
<nav class="om-docs-navigation" aria-label={t.title}><a class="docs-home" href={docsHome(base,locale)} aria-current={!slug ? 'page' : undefined}>{t.title}</a>{groups.map(group => <div class="nav-group om-docs-group"><h2 class="om-docs-group-label">{group.label}</h2><ul class="om-docs-links" role="list">{group.items.map(({slug: path,label,href}) => <li><a href={href} aria-current={slug.replace(/\.(?:ko|ja|zh-cn)$/,'') === path ? 'page' : undefined}>{label}</a></li>)}</ul></div>)}</nav>
