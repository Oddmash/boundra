---
import { localGroups, docsHome } from '../docs-nav';
import { docCopy, localeFromLang } from '../doc-ui-copy';
const { slug = '', lang = 'en' } = Astro.props;
const locale = localeFromLang(lang);
const t = docCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const groups = localGroups(base,locale);
---
<nav aria-label={t.title}><a class="docs-home" href={docsHome(base,locale)} aria-current={!slug ? 'page' : undefined}>{t.title}</a>{groups.map(group => <div class="nav-group"><h2>{group.label}</h2>{group.items.map(({slug: path,label,href}) => <a href={href} aria-current={slug.replace(/\.(?:ko|ja|zh-cn)$/,'') === path ? 'page' : undefined}>{label}</a>)}</div>)}</nav>
