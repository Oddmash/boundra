---
import Docs from './docs.astro';
import { localGroups } from '../docs-nav';
import { docCopy } from '../doc-ui-copy';
import { htmlLanguage, type LandingLocale } from '../landing-copy';
const { locale = 'en' } = Astro.props as {locale?: LandingLocale};
const t = docCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const groups = localGroups(base,locale);
const readableDocs = {
  en: 'AI-readable documentation (llms.txt)',
  ko: 'AI용 문서 (llms.txt)',
  ja: 'AI 向けドキュメント (llms.txt)',
  'zh-cn': '供 AI 阅读的文档 (llms.txt)',
}[locale];
---
<Docs title={t.title} lang={htmlLanguage(locale)}>
  <h1>{t.title}</h1><p class="doc-intro">{t.intro}</p>
  {t.available && <p>{t.available}</p>}
  {groups.map(group => <section><h2>{group.label}</h2><ul class="reference-list">{group.items.map(({href,label}) => <li><a href={href}>{label}</a></li>)}</ul></section>)}
  {locale === 'en' && <><h2>Additional reference</h2><p><a href={base + 'docs/readme/'}>Full documentation index</a></p></>}
  <p><a href={base + 'llms.txt'}>{readableDocs}</a></p>
</Docs>
