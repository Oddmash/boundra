---
import '../styles.css';
const { title, description = 'Boundra documentation for TypeScript applications.', lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const docs = `${base}docs/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} />
    <title>{title}</title><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /><link rel="icon" href={`${base}boundra-mark.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header"><div class="shell nav"><a class="brand" href={base}><img src={`${base}boundra-mark.svg`} width="32" height="32" alt="" />Boundra</a><nav aria-label="Main navigation"><a href={`${docs}user-guide/`}>Guide</a><a href={docs}>Docs</a><a href={`${docs}example/`}>Example</a><a href="https://github.com/Oddmash/boundra">GitHub <span aria-hidden="true">↗</span></a></nav></div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer"><a class="brand" href={base}><img src={`${base}boundra-mark.svg`} alt="" width="26" height="26" />Boundra</a><span>Open source by Oddmash · MIT</span><nav aria-label="Footer navigation"><a href={docs}>Documentation</a><a href="https://www.npmjs.com/package/boundra">npm</a><a href="https://github.com/Oddmash/boundra">Source</a></nav></div></footer>
  </body>
</html>
