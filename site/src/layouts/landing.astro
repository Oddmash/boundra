---
import Layout from './site.astro';
import { docsHome, docPath } from '../docs-nav';
import { docCopy } from '../doc-ui-copy';
import { landingCopy, htmlLanguage, guidePath, type LandingLocale } from '../landing-copy';
import { Button } from '@oddmash/ui/button';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
const { locale = 'en' } = Astro.props as { locale?: LandingLocale };
const t = landingCopy[locale];
const stageControl = (attribute: 'data-play' | 'data-next', label: string, glyph: string) => renderToStaticMarkup(createElement(Button, {
  variant: 'secondary',
  size: 'sm',
  hidden: true,
  [attribute]: '',
  'aria-label': label,
  title: label,
}, createElement('span', { 'aria-hidden': true }, glyph)));
const guide = guidePath(import.meta.env.BASE_URL.replace(/\/$/, '') + '/', locale);

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const docs = docsHome(base,locale);
const reference = (slug: string) => docPath(base,slug,locale) ?? guide;
const commands = `pnpm add boundra zod
pnpm exec boundra init --name my-app
pnpm exec boundra create-domain order
pnpm exec boundra create-domain billing
pnpm exec boundra add-dependency billing/order
pnpm exec boundra check-boundaries`;
const tree = `domains/
  order/
    client/
    server/
    shared/
      public.ts
  billing/
    client/
    server/
    shared/`;
const contract = `import { defineQuery } from "boundra";
import { z } from "zod";

export const getOrderQuery = defineQuery({
  name: "get-order",
  input: z.object({ orderId: z.string().min(1) }),
  result: z.object({ orderId: z.string(), status: z.string() }),
});`;
const sections = [
  [t.docStart, t.docStartDesc, 'user-guide'],
  [docCopy[locale].example, docCopy[locale].exampleIntro, 'example'],
  [t.docRules, t.docRulesDesc, 'boundary-rules'],
  [t.docContracts, t.docContractsDesc, 'contract-schema-spec'],
  [t.docFramework, t.docFrameworkDesc, 'framework-conformance'],
  [t.docConfig, t.docConfigDesc, 'config-spec'],
  [t.docCI, t.docCIDesc, 'ci-integration'],
].flatMap(([title, description, slug]) => {
  const href = docPath(base,slug,locale);
  return href ? [[title, description, href]] : [];
});
const story = ({"en":{"chapter1":"Layer boundaries","chapter2":"Public interfaces","chapter3":"Declared dependencies","blocked":"Violation detected","fixed":"Correction verified","pass1":"Shared contract, valid import","pass1Desc":"The client imports the shared contract instead of server implementation.","pass2":"Public interface, valid import","pass2Desc":"Billing accesses the declared public API instead of order’s internal implementation.","story":"Boundra checks imports against layer rules, public entry points and the dependency manifest before a change merges."},"ko":{"chapter1":"계층 경계","chapter2":"공개 인터페이스","chapter3":"선언된 의존성","blocked":"위반 감지","fixed":"수정 검증 완료","pass1":"공유 계약으로 변경","pass1Desc":"클라이언트가 서버 구현 대신 공유 계약을 가져옵니다.","pass2":"공개 인터페이스로 변경","pass2Desc":"billing이 order의 내부 구현 대신 선언된 공개 API에 접근합니다.","story":"Boundra는 import를 계층 규칙, 공개 진입점과 의존성 선언에 대조해 병합 전에 검사합니다."},"ja":{"chapter1":"レイヤー境界","chapter2":"公開インターフェース","chapter3":"宣言済みの依存関係","blocked":"違反を検出","fixed":"修正を確認","pass1":"共有契約による有効な import","pass1Desc":"クライアントはサーバー実装ではなく共有契約を import します。","pass2":"公開インターフェースへの修正","pass2Desc":"billing は order の内部実装ではなく宣言済みの公開 API にアクセスします。","story":"Boundra はマージ前に import をレイヤールール、公開エントリーポイント、依存関係の宣言と照合します。"},"zh-cn":{"chapter1":"分层边界","chapter2":"公开接口","chapter3":"已声明的依赖关系","blocked":"检测到违规","fixed":"修正已验证","pass1":"共享契约，有效的 import","pass1Desc":"客户端导入共享契约，而不是服务端实现。","pass2":"公开接口，有效的 import","pass2Desc":"billing 访问 order 声明的公开 API，而不是内部实现。","story":"Boundra 在合并前根据分层规则、公开入口和依赖清单检查 import。"}})[locale];
const flow = ({
  en: { source: 'Source change', revised: 'Revised change', checker: 'Boundary inspector', blocked: 'Blocked', allowed: 'Allowed', scan: 'Scanning source', check: 'Evaluating rule', decision: 'Routing result', complete: 'Check complete', pending: 'Awaiting the boundary check result' },
  ko: { source: '소스 변경', revised: '수정된 변경', checker: '경계 검사기', blocked: '차단', allowed: '허용', scan: '소스 검사 중', check: '규칙 검증 중', decision: '결과 전달 중', complete: '검사 완료', pending: '경계 검사 결과를 기다리는 중' },
  ja: { source: 'ソース変更', revised: '修正後の変更', checker: '境界チェッカー', blocked: '拒否', allowed: '許可', scan: 'ソースを検査中', check: 'ルールを検証中', decision: '結果を転送中', complete: '検査完了', pending: '境界チェックの結果を待機中' },
  'zh-cn': { source: '源代码变更', revised: '修正后的变更', checker: '边界检查器', blocked: '阻止', allowed: '允许', scan: '正在扫描源代码', check: '正在验证规则', decision: '正在传递结果', complete: '检查完成', pending: '等待边界检查结果' },
})[locale];
const blockedBranch = 'M50 0 V12 Q50 20 42 20 H33 Q25 20 25 28 V40';
const allowedBranch = 'M50 0 V12 Q50 20 58 20 H67 Q75 20 75 28 V40';
const scenes = [
  { chapter: story.chapter1, rule: 'BR-001', title: t.rule1Title, description: t.rule1Desc, source: 'order', sourceLayer: 'client', target: 'order', targetLayer: 'server/internal', path: 'domains/order/client/use-order.ts', symbol: 'orderService', imported: '@domains/order/server/internal', dependency: '[]', allowed: false },
  { chapter: story.chapter1, rule: 'PASS', title: story.pass1, description: story.pass1Desc, source: 'order', sourceLayer: 'client', target: 'order', targetLayer: 'shared/public', path: 'domains/order/client/use-order.ts', symbol: 'getOrderQuery', imported: '@domains/order/shared/public', dependency: '[]', allowed: true },
  { chapter: story.chapter2, rule: 'BR-004', title: t.rule4Title, description: t.rule4Desc, source: 'billing', sourceLayer: 'server', target: 'order', targetLayer: 'server/internal', path: 'domains/billing/server/invoice.ts', symbol: 'orderService', imported: '@domains/order/server/internal', dependency: '["order"]', allowed: false },
  { chapter: story.chapter2, rule: 'PASS', title: story.pass2, description: story.pass2Desc, source: 'billing', sourceLayer: 'server', target: 'order', targetLayer: 'shared/public', path: 'domains/billing/server/invoice.ts', symbol: 'getOrderQuery', imported: '@domains/order/shared/public', dependency: '["order"]', allowed: true },
  { chapter: story.chapter3, rule: 'BR-006', title: t.rule6Title, description: t.rule6Desc, source: 'billing', sourceLayer: 'server', target: 'order', targetLayer: 'shared/public', path: 'domains/billing/server/invoice.ts', symbol: 'getOrderQuery', imported: '@domains/order/shared/public', dependency: '[]', allowed: false },
  { chapter: story.chapter3, rule: 'PASS', title: t.passTitle, description: t.passDesc, source: 'billing', sourceLayer: 'server', target: 'order', targetLayer: 'shared/public', path: 'domains/billing/server/invoice.ts', symbol: 'getOrderQuery', imported: '@domains/order/shared/public', dependency: '["order"]', allowed: true },
];
---
<Layout title={`Boundra | ${t.eyebrow}`} description={t.meta} lang={htmlLanguage(locale)} landingLocale={locale}>
  <div class="landing">
  <div class="hero-band"><section class="hero shell">
    <div class="hero-copy">
      <p class="version">{t.eyebrow}</p>
      <h1>{t.headline} <span>{t.accent}</span></h1>
      <p class="lead">{t.lead}</p><p class="hero-proof">{story.story}</p>
      <div class="actions"><a class="button primary om-button om-button--link om-button--primary om-button--md" href={guide}>{t.start} <span aria-hidden="true">→</span></a><a class="button secondary om-button om-button--link om-button--secondary om-button--md" href={docs}>{t.docs}</a></div>
      <p class="requirements">{t.requirements}</p>
    </div>
    <div class="boundary-stage" data-boundary-stage data-pause={t.pause} data-resume={t.resume} data-phase="result" data-phase-copy={JSON.stringify({ scan: flow.scan, checking: flow.check, decision: flow.decision, result: flow.complete })}>
      <div class="stage-top">
        <div class="stage-command"><span aria-hidden="true">$</span><span>boundra check-boundaries</span></div>
        <div class="stage-controls" data-om-theme="dark"><Fragment set:html={stageControl('data-play', t.pause, 'Ⅱ')} /><Fragment set:html={stageControl('data-next', t.next, '→')} /></div>
      </div>
      <div class="scene-stack">
        {scenes.map((scene, index) => (
          <div class:list={['scene', { accepted: scene.allowed }]} data-scene={index} data-active={index === 0 ? 'true' : 'false'} aria-hidden={index !== 0 ? 'true' : undefined}>
            <div class="scene-code">
              <div class="source-caption"><strong>{scene.allowed ? flow.revised : flow.source}</strong><span class="source-tag">{scene.source}/{scene.sourceLayer}</span></div>
              <span class="preview-path">{scene.path}</span>
              <pre><code><span class="syntax-keyword">import</span> {'{ ' + scene.symbol + ' }'} <span class="syntax-keyword">from</span>{'\n'}  <span class:list={['syntax-string', { revised: index === 1 || index === 3 }]}>{'"' + scene.imported + '"'}</span>;</code></pre>
              <div class="manifest-line"><span>{scene.source}/domain.json</span><code class:list={[{ revised: index === 5 }]}>"dependsOn": {scene.dependency}</code></div>
            </div>
            <div class="scan-wire" aria-hidden="true">
              <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                <path class="wire-track" d="M50 0 V40" />
                <path class="wire-signal scan-signal" d="M50 0 V40" />
              </svg>
            </div>
            <div class="checker">
              <div class="checker-mark"><img src={base + 'boundra-mark.svg'} width="28" height="28" alt="" /></div>
              <div class="checker-copy"><span>{flow.checker}</span><strong>{scene.chapter}</strong></div>
              <code class="checker-rule">{scenes[index - index % 2].rule}</code>
              <div class="check-meter" aria-hidden="true"><span></span></div>
            </div>
            <div class="decision-wire" aria-hidden="true">
              <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                <path class="wire-track" data-branch="blocked" d={blockedBranch} />
                <path class="wire-track" data-branch="allowed" d={allowedBranch} />
                <path class="wire-signal decision-signal" d={scene.allowed ? allowedBranch : blockedBranch} />
              </svg>
            </div>
            <div class="decision-grid">
              <div class="outcome-cell">
                <div class="outcome blocked" data-outcome="blocked" data-selected={String(!scene.allowed)}>
                  <span class="outcome-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="m5 5 6 6M11 5l-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                  <strong>{flow.blocked}</strong><code>{scenes[index - index % 2].rule}</code>
                </div>
              </div>
              <div class="outcome-cell">
                <div class="outcome allowed" data-outcome="allowed" data-selected={String(scene.allowed)}>
                  <span class="outcome-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="m4 8 2.7 2.7L12 5.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <strong>{flow.allowed}</strong><code>PASS</code>
                </div>
              </div>
            </div>
            <div class="scene-summary">
              <div class="scene-result"><span class="rule">{scene.rule}</span><div><strong data-scene-title>{scene.title}</strong><p>{scene.description}</p></div></div>
              <div class="scene-pending" aria-hidden="true">{flow.pending}</div>
            </div>
          </div>
        ))}
      </div>
      <div class="stage-footer"><span class="stage-phase" data-phase-label>{flow.complete}</span><p class="preview-note">{t.note}</p></div>
      <p class="sr-only" data-status role="status"></p>
    </div>
  </section></div>
  <section class="shell content-section" id="quickstart">
    <div class="section-heading"><h2>{t.quickTitle}</h2><p>{t.quickDesc}</p></div>
    <div class="walkthrough">
      <div><h3>{t.install}</h3><p>{t.installDesc}</p><div class="code-panel om-code-block"><div class="code-caption om-code-block-header"><span class="om-code-block-caption">{t.terminal}</span></div><pre class="om-code-block-content" tabindex="0"><code>{commands}</code></pre></div><a class="text-link" href={reference("cli-install")}>{t.installLink} <span aria-hidden="true">→</span></a></div>
      <div><h3>{t.structure}</h3><p>{t.structureDesc}</p><div class="file-tree om-code-block"><pre class="om-code-block-content" tabindex="0"><code>{tree}</code></pre></div><a class="text-link" href={reference("domain-manifest-spec")}>{t.manifest} <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  <section class="shell content-section split-section">
    <div><h2>{t.contractTitle}</h2><p>{t.contractDesc}</p><p>{t.contractDesc2}</p><a class="text-link" href={locale === "en" ? guide + "#4-implement-a-real-contract" : guide}>{t.contractLink} <span aria-hidden="true">→</span></a></div>
    <div class="code-panel om-code-block"><div class="code-caption om-code-block-header"><span class="om-code-block-caption">domains/order/shared/contracts/get-order.ts</span></div><pre class="om-code-block-content" tabindex="0"><code>{contract}</code></pre></div>
  </section>
  <section class="shell content-section split-section" id="ci">
    <div><h2>{t.ciTitle}</h2><p>{t.ciDesc}</p><a class="text-link" href={reference("ci-integration")}>{t.ciLink} <span aria-hidden="true">→</span></a></div>
    <div class="code-panel om-code-block"><div class="code-caption om-code-block-header"><span class="om-code-block-caption">{t.terminal}</span></div><pre class="om-code-block-content" tabindex="0"><code>pnpm exec boundra check-boundaries --format json</code></pre></div>
  </section>
  <section class="shell content-section" id="documentation">
    <div class="section-heading"><h2>{t.docsTitle}</h2><p>{t.docsDesc}</p></div>
    <div class="doc-list">{sections.map(([title, description, href]) => <a class="om-link-card" href={href}><div><h3>{title}</h3><p>{description}</p></div><span class="om-link-card-arrow" aria-hidden="true">→</span></a>)}</div>
    <a class="text-link" href={docs}>{t.docsAll} <span aria-hidden="true">→</span></a>
  </section>
  <section class="shell content-section fit-section"><h2>{t.fitTitle}</h2><p>{t.fitDesc}</p><a class="text-link" href={reference("product-positioning")}>{t.fitLink} <span aria-hidden="true">→</span></a></section>
  </div>
</Layout>

<script>
  type ScanPhase = 'scan' | 'checking' | 'decision' | 'result';
  const inputEnd = 620;
  const checkEnd = 1060;
  const decisionEnd = 1690;
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const branchPath = (width: number, height: number, allowed: boolean) => {
    const center = width / 2;
    const target = width * (allowed ? .75 : .25);
    const junction = height / 2;
    const bend = Math.min(8, height / 5, width / 12);
    const direction = allowed ? 1 : -1;
    return `M${center} 0 V${junction - bend} Q${center} ${junction} ${center + direction * bend} ${junction} H${target - direction * bend} Q${target} ${junction} ${target} ${junction + bend} V${height}`;
  };

  for (const stage of document.querySelectorAll<HTMLElement>('[data-boundary-stage]')) {
    const scenes = Array.from(stage.querySelectorAll<HTMLElement>('[data-scene]'));
    const play = stage.querySelector<HTMLButtonElement>('[data-play]')!;
    const next = stage.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = stage.querySelector<HTMLElement>('[data-status]')!;
    const phaseLabel = stage.querySelector<HTMLElement>('[data-phase-label]')!;
    const labels = JSON.parse(stage.dataset.phaseCopy!) as Record<ScanPhase, string>;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let paused = false;
    let visible = false;
    let elapsed = 0;
    let last: number | undefined;
    let frame: number | undefined;

    const measureRoutes = () => {
      for (const scene of scenes) {
        const scan = scene.querySelector<HTMLElement>('.scan-wire')!;
        const decision = scene.querySelector<HTMLElement>('.decision-wire')!;
        for (const [wire, isDecision] of [[scan, false], [decision, true]] as const) {
          const { width, height } = wire.getBoundingClientRect();
          if (!width || !height) continue;
          const svg = wire.querySelector('svg')!;
          svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
          const signal = svg.querySelector<SVGPathElement>('.wire-signal')!;
          if (isDecision) {
            const blocked = branchPath(width, height, false);
            const allowed = branchPath(width, height, true);
            svg.querySelector('[data-branch="blocked"]')!.setAttribute('d', blocked);
            svg.querySelector('[data-branch="allowed"]')!.setAttribute('d', allowed);
            signal.setAttribute('d', scene.classList.contains('accepted') ? allowed : blocked);
          } else {
            const path = `M${width / 2} 0 V${height}`;
            svg.querySelector('.wire-track')!.setAttribute('d', path);
            signal.setAttribute('d', path);
          }
          signal.style.setProperty('--wire-length', `${signal.getTotalLength()}px`);
        }
      }
      stage.dataset.geometryReady = 'true';
    };

    const render = () => {
      const phase: ScanPhase = elapsed < inputEnd ? 'scan' : elapsed < checkEnd ? 'checking' : elapsed < decisionEnd ? 'decision' : 'result';
      if (stage.dataset.phase !== phase) {
        stage.dataset.phase = phase;
        phaseLabel.textContent = labels[phase];
      }
      stage.style.setProperty('--input-offset', String(100 * (1 - clamp(elapsed / inputEnd))));
      stage.style.setProperty('--check-progress', String(clamp((elapsed - inputEnd) / (checkEnd - inputEnd))));
      stage.style.setProperty('--decision-offset', String(100 * (1 - clamp((elapsed - checkEnd) / (decisionEnd - checkEnd)))));
    };

    const renderControls = () => {
      play.hidden = reduced.matches;
      next.hidden = !reduced.matches && !paused;
      const name = paused ? stage.dataset.resume! : stage.dataset.pause!;
      play.setAttribute('aria-label', name);
      play.title = name;
      play.querySelector('span')!.textContent = paused ? '▶' : 'Ⅱ';
    };

    const select = (index: number, manual = false) => {
      current = index % scenes.length;
      elapsed = manual ? decisionEnd : 0;
      for (const [i, scene] of scenes.entries()) {
        scene.dataset.active = String(i === current);
        if (i === current) scene.removeAttribute('aria-hidden');
        else scene.setAttribute('aria-hidden', 'true');
      }
      render();
      if (manual) status.textContent = scenes[current].querySelector('[data-scene-title]')!.textContent;
    };

    const stop = () => {
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = last = undefined;
      stage.dataset.running = 'false';
    };

    const tick = (now: number) => {
      if (last !== undefined) elapsed += Math.min(now - last, 100);
      last = now;
      const duration = scenes[current].classList.contains('accepted') ? 3100 : 3500;
      if (elapsed >= duration) select(current + 1);
      else render();
      frame = requestAnimationFrame(tick);
    };

    const schedule = () => {
      stop();
      if (!reduced.matches && !paused && visible && !document.hidden) {
        stage.dataset.running = 'true';
        frame = requestAnimationFrame(tick);
      }
    };

    play.addEventListener('click', () => {
      paused = !paused;
      renderControls();
      schedule();
    });

    next.addEventListener('click', () => {
      if (!reduced.matches) paused = true;
      select(current + 1, true);
      renderControls();
      schedule();
    });

    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', () => {
      elapsed = reduced.matches ? decisionEnd : 0;
      render();
      renderControls();
      schedule();
    });
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= 0.35;
      schedule();
    }, { threshold: [0, 0.35] });
    observer.observe(stage);
    const resize = new ResizeObserver(measureRoutes);
    for (const wire of stage.querySelectorAll('.scan-wire,.decision-wire')) resize.observe(wire);
    window.addEventListener('pagehide', stop);
    window.addEventListener('pageshow', schedule);
    elapsed = decisionEnd;
    measureRoutes();
    render();
    stage.dataset.ready = 'true';
    renderControls();
  }
</script>
<style>
  .landing { --landing-surface: #f8f7f5; --landing-border: #e3e0dc; }
  .hero-band { color: #f4f2ed; background: #111110; }
  .landing .hero {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.14fr);
    gap: clamp(36px, 5vw, 82px);
    min-height: calc(100svh - 69px);
    padding-block: clamp(48px, 6vw, 88px);
  }
  .landing .hero h1 { font-size: clamp(44px, 5.7vw, 83px); font-weight: 750; letter-spacing: -.062em; line-height: 1.07; text-wrap: balance; margin-block: 16px 24px; }
  .hero h1 span { color: #ff9c61; }
  .landing .version { color: #b9b6af; font-weight: 600; margin-top: 0; }
  .landing .lead { color: #d2cec8; font-size: clamp(17px,1.55vw,20px); }
  .landing .requirements { color: #b6b1aa; }
  .landing .actions { margin-block: 30px 16px; }
  .hero .primary { --om-semantic-color-action:#f4f2ed; --om-semantic-color-on-action:#171716; --om-semantic-color-action-hover:#ddd8d0; --om-semantic-color-border:#f4f2ed; }
  .hero .secondary { --om-semantic-color-text:#f4f2ed; --om-semantic-color-border:#6d6860; --om-semantic-color-surface:transparent; --om-semantic-color-bg:#292724; }
  .hero a:focus-visible, .stage-controls :global(button:focus-visible) { outline: 2px solid #ffbf91; outline-offset: 4px; }
  .boundary-stage { position:relative; min-width:0; background:radial-gradient(ellipse at 50% 33%,#29231e 0,#1a1917 45%,#141413 80%); border:1px solid #39342e; border-radius:22px; padding:clamp(15px,2.3vw,28px); box-shadow:0 25px 75px #0005; --input-offset:0; --check-progress:1; --decision-offset:0; }
  .hero-proof { color:#b4aea6; max-width:46ch; font-size:14px; line-height:1.6; margin:10px 0 0; }
  .stage-top { display:flex; justify-content:space-between; gap:8px; align-items:center; color:#d5d0c8; font:12px/1.5 var(--mono); margin-bottom:20px; min-height:44px; }
